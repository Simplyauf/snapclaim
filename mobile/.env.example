# Backend base URL. Leave unset to use the built-in sample parser, which lets
# capture and review work with no backend and no API costs.
# Use your machine's LAN IP, not localhost — the phone is a different host.
EXPO_PUBLIC_API_URL=http://192.168.1.10:8787

# Set to 1 to open the design preview instead of the app.
# EXPO_PUBLIC_PREVIEW=1
