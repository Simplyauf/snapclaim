# Every setting the server needs. Copy to .env and fill in.

# Signing secret for wallet session tokens. Any long random string.
# Generate one with: openssl rand -base64 48
JWT_SECRET=

# Port the server listens on.
PORT=8787

# Interface to bind. Leave unset for local development (binds 0.0.0.0 so a
# phone on the same Wi-Fi can reach it). Behind nginx or any reverse proxy,
# set 127.0.0.1 so the port is not reachable from the internet directly.
# HOST=127.0.0.1

# ---------------------------------------------------------------- vision
# Which provider reads receipts. "claude" or "openai-compatible".
#
# Verified working on Groq's free tier, 6/6 fields correct in ~1.5s:
#   VISION_PROVIDER=openai-compatible
#   VISION_BASE_URL=https://api.groq.com/openai/v1
#   VISION_MODEL=qwen/qwen3.8-27b
#
# Groq caveat: most Groq models are TEXT ONLY and reject images outright.
# qwen3.8-27b is the vision-capable one as of Oct 2026 — check with
# `npm run vision:check` before trusting any other model id.
VISION_PROVIDER=openai-compatible

# --- if VISION_PROVIDER=claude
# Lives ONLY here, never in the APK.
ANTHROPIC_API_KEY=sk-ant-...
# VISION_MODEL=claude-opus-5

# --- if VISION_PROVIDER=openai-compatible
# Any host speaking /v1/chat/completions — this is how you run an
# open-weights model. Accuracy on small thermal print is usually lower than
# Claude's; manual entry stays available either way (FR-10).
#
#   OpenRouter: VISION_BASE_URL=https://openrouter.ai/api/v1
#               VISION_MODEL=qwen/qwen2.5-vl-72b-instruct
#   Groq:       VISION_BASE_URL=https://api.groq.com/openai/v1
#               VISION_MODEL=qwen/qwen3.8-27b   (free tier, verified)
#   Ollama:     VISION_BASE_URL=http://localhost:11434/v1   (leave key empty)
#
# VISION_BASE_URL=
# VISION_MODEL=
# VISION_API_KEY=
